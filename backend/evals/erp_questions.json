   "fake": {"rank_customers": {"by": "services", "customers": [{"customer_no": "C90001", "name": "Test Bank Ltd", "services": 40}, {"customer_no": "C90005", "name": "Uncovered Ltd", "services": 35}]},
            "find_contracts": {"contracts": [{"contract_no": "SC90011", "customer_no": "C90001", "customer_name": "Test Bank Ltd", "status": "signed", "active": true}]},
            "customers_without_active_contract": {"total": 1, "customers": [{"customer_no": "C90005", "name": "Uncovered Ltd", "services": 35}]}},
