[
  {"id": "customer-by-number", "question": "Who is customer C90001?",
   "expect_lookups": ["find_customers"],
   "fake": {"find_customers": {"customers": [{"number": "C90001", "name": "Test Bank Ltd", "city": "Nairobi", "blocked": false}]}},
   "expect_facts": ["Test Bank Ltd", "Nairobi"]},

  {"id": "customer-services", "question": "What services does C90001 have?",
   "expect_lookups": ["customer_services"],
   "fake": {"customer_services": {"customer_no": "C90001", "customer_name": "Test Bank Ltd", "total": 3,
     "by_group": [{"group_code": "GUARD", "group_name": "Guard posts", "items": 2}, {"group_code": "ALARM", "group_name": "Alarm services", "items": 1}],
     "items": [{"number": "SI9001", "description": "Guard post Main Branch"}, {"number": "SI9002", "description": "Guard post ATM"}, {"number": "SI9003", "description": "Alarm Main Branch"}]}},
   "expect_facts": ["3", "guard", "alarm"]},

  {"id": "service-total", "question": "How many alarm services do we have?",
   "expect_lookups": ["service_summary"],
   "fake": {"service_summary": {"group": "alarm", "total": 412, "customers": 187, "by_group": [{"group_code": "ALARM", "group_name": "Alarm services", "items": 412}]}},
   "expect_facts": ["412"]},

  {"id": "active-contracts", "question": "How many active contracts do we have, and what are they worth a year?",
   "expect_lookups": ["contract_summary"],
   "fake": {"contract_summary": {"show": "active", "active": 58, "active_annual_amount": 1234567.0, "signed": 70, "not_signed": 9, "cancelled": 4}},
   "expect_facts": ["58", ["1234567", "1.23 million", "1.2 million"]]},

  {"id": "overdue-invoices", "question": "Which contract invoices are overdue?",
   "expect_lookups": ["contract_summary"],
   "fake": {"contract_summary": {"show": "invoice_overdue", "invoice_overdue": 2,
     "contracts": [{"contract_no": "SC90011", "customer_name": "Test Bank Ltd", "next_invoice_date": "2026-10-01"}, {"contract_no": "SC90012", "customer_name": "Sample Stores", "next_invoice_date": "2026-09-15"}]}},
   "expect_facts": ["SC90011", "SC90012"]},

  {"id": "contract-next-invoice", "question": "When is contract SC90011 next invoiced?",
   "expect_lookups": [["find_contracts", "contract_details"]],
   "fake": {"find_contracts": {"contracts": [{"contract_no": "SC90011", "customer_name": "Test Bank Ltd", "status": "signed", "next_invoice_date": "2026-12-01", "invoice_period": "monthly"}]},
            "contract_details": {"found": true, "contract": {"contract_no": "SC90011", "customer_name": "Test Bank Ltd", "status": "signed", "next_invoice_date": "2026-12-01", "invoice_period": "monthly"}, "lines": [], "line_count": 0}},
   "expect_facts": [["2026-12-01", "1 december 2026", "december 1, 2026", "1 dec 2026", "dec 1, 2026", "1st december 2026", "01/12/2026"]]},

  {"id": "contract-lines", "question": "Which service items does contract SC90011 cover, and at what price each?",
   "expect_lookups": ["contract_details"],
   "fake": {"contract_details": {"found": true, "contract": {"contract_no": "SC90011", "customer_name": "Test Bank Ltd", "status": "signed"},
     "lines": [{"service_item_no": "SI9001", "description": "Guard post Main Branch", "line_amount": 45000}, {"service_item_no": "SI9003", "description": "Alarm Main Branch", "line_amount": 3500}],
     "line_count": 2, "lines_total_amount": 48500}},
   "expect_facts": ["SI9001", "SI9003", "45000", "3500"]},

  {"id": "blocked", "question": "How many customers are blocked, and who are they?",
